{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wzcitytcds.open/schemas/entity-lookup.schema.json",
  "title": "Hub Entity Lookup and Resolution Contract",
  "description": "Standard schema for resolving candidate entity mentions against the City Spatial-Temporal Trusted Content Hub master data.",
  "type": "object",
  "required": [
    "protocol_version",
    "message_id",
    "timestamp",
    "message_type"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg_[a-zA-Z0-9_-]{12,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "message_type": {
      "type": "string",
      "enum": ["LOOKUP_REQUEST", "LOOKUP_RESPONSE"]
    },
    "request": {
      "type": "object",
      "required": ["query_text"],
      "properties": {
        "query_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_snippet": {
          "type": "string",
          "maxLength": 2048
        },
        "expected_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "POI",
              "ADMIN_DIVISION",
              "ORGANIZATION",
              "PERSON",
              "EVENT",
              "GEO_FEATURE",
              "NATURAL_RESOURCE"
            ]
          }
        },
        "spatial_filter": {
          "type": "object",
          "properties": {
            "region_code": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "bounding_box": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["resolution_status", "matches"],
      "properties": {
        "resolution_status": {
          "type": "string",
          "enum": ["EXACT_MATCH", "MULTIPLE_MATCHES", "UNRESOLVED_NOT_FOUND"]
        },
        "selected_entity_id": {
          "type": "string",
          "pattern": "^ent_[a-z0-9_-]{8,64}$"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "canonical_name", "category", "confidence"],
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^ent_[a-z0-9_-]{8,64}$"
              },
              "canonical_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "aliases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "category": {
                "type": "string",
                "enum": [
                  "POI",
                  "ADMIN_DIVISION",
                  "ORGANIZATION",
                  "PERSON",
                  "EVENT",
                  "GEO_FEATURE",
                  "NATURAL_RESOURCE"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "hub_uri": {
                "type": "string",
                "format": "uri"
              },
              "spatial_coordinates": {
                "type": "object",
                "required": ["longitude", "latitude"],
                "properties": {
                  "longitude": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
                  "latitude": { "type": "number", "minimum": -90.0, "maximum": 90.0 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
